# Optional: point the dashboard to a different checkpoint directory.
CHECKPOINT_DIR=project_checkpoint

# Optional: enable PostgreSQL reads and analyst-feedback persistence.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/maritime_monitoring

# NASA FIRMS key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# NASA_FIRMS_MAP_KEY=replace_with_your_private_key

# Optional operational thresholds. These create review alerts, not conflict labels.
NASA_ALERT_FRP_MEDIUM=10
NASA_ALERT_FRP_HIGH=20
