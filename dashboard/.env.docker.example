# Copy this file to dashboard/.env and fill in the values locally.
# Never commit dashboard/.env.

# Absolute path to your local data directory, e.g. C:/projects/maritime/project_checkpoint
CHECKPOINT_HOST_DIR=/absolute/path/to/project_checkpoint
NASA_FIRMS_MAP_KEY=replace_with_a_new_private_key

# Optional existing PostgreSQL connection from inside Docker Desktop.
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@host.docker.internal:5433/maritime_monitoring
DATABASE_URL=

NASA_ALERT_FRP_MEDIUM=10
NASA_ALERT_FRP_HIGH=20
